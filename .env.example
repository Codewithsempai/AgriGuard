# AgriGuard AI Configuration

# FastAPI Backend Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-string-for-production-deployment-2026
ADMIN_EMAIL=admin@agriguard.com

# SQLite Database Connection (Local Windows file-based)
DATABASE_URL=sqlite:///agriguard.db

# Storage Directories
UPLOAD_DIR=uploads

# AI Deep-Learning Model Paths
MODEL_PATH=models/disease_model.keras
LABELS_PATH=models/labels.json

# Frontend Vite API Proxy Target
VITE_API_URL=http://localhost:8000/api/v1
